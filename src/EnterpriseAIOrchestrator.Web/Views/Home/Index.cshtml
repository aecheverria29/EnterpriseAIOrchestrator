@model HomeIndexViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<section class="dashboard-hero">
    <div class="hero-content">
        <p class="eyebrow">Operations dashboard</p>
        <h1>Enterprise AI Workflow Orchestrator</h1>
        <p class="hero-copy">
            Internal request intake, routing, review, and audit tracking for business operations.
        </p>
        <div class="tech-pills">
            <span>.NET 10</span>
            <span>MVC + Web API</span>
            <span>Rule-Based Routing</span>
            <span>Human-in-the-Loop</span>
            <span>Audit Trail</span>
        </div>
    </div>
    <div class="dashboard-brief">
        <span class="panel-label">Processing posture</span>
        <strong>Rule-based orchestration</strong>
        <p>Requests are classified, routed, reviewed when policy requires it, and stored with a traceable audit history.</p>
    </div>
</section>

<section class="summary-strip">
    <div class="metric-card metric-health">
        <span>API Health</span>
        <strong>
            <span class="status-dot @(Model.ApiHealth.IsAvailable ? "status-dot-ok" : "status-dot-down")"></span>
            @Model.ApiHealth.Status
        </strong>
        <small>@Model.ApiHealth.Service</small>
    </div>
    <div class="metric-card">
        <span>Requests In Review</span>
        <strong>@Model.RequestsInReview</strong>
        <small>Derived from recent workflow runs</small>
    </div>
    <div class="metric-card">
        <span>Recent Runs</span>
        <strong>@Model.RecentRunCount</strong>
        <small>Latest in-memory workflow activity</small>
    </div>
    <div class="metric-card">
        <span>Default Processing Mode</span>
        <strong>Deterministic</strong>
        <small>Rule-based classification and routing</small>
    </div>
</section>

<section class="dashboard-grid">
    <div class="panel action-panel">
        <div class="section-heading">
            <span class="panel-label">Quick actions</span>
            <h2>Move work through the pipeline</h2>
        </div>
        <div class="quick-actions">
            <a class="action-card action-primary" asp-controller="Requests" asp-action="Create">
                <span>Submit Request</span>
                <strong>Create a new workflow run</strong>
            </a>
            <a class="action-card" asp-controller="Requests" asp-action="Lookup">
                <span>Lookup Run</span>
                <strong>Inspect current state and audit history</strong>
            </a>
            <a class="action-card" asp-controller="Requests" asp-action="Recent">
                <span>View Recent Runs</span>
                <strong>Review intake activity across operations</strong>
            </a>
        </div>
    </div>

    <div class="panel">
        <div class="section-heading">
            <span class="panel-label">Recent activity</span>
            <h2>Latest workflow runs</h2>
        </div>
        @if (Model.RecentRuns.Count == 0)
        {
            <p class="empty-state">No recent runs are available yet.</p>
        }
        else
        {
            <div class="compact-run-list">
                @foreach (var run in Model.RecentRuns.Take(5))
                {
                    <a asp-controller="Requests" asp-action="Details" asp-route-runId="@run.RunId">
                        <span>
                            <strong>@run.OriginalTitle</strong>
                            <small>@run.BusinessUseCase &middot; @run.DefaultOwner</small>
                        </span>
                        <span class="status-badge @BadgeClass(run.WorkflowStatus)">@run.WorkflowStatus</span>
                    </a>
                }
            </div>
        }
    </div>
</section>

@functions {
    private static string BadgeClass(string status) => status switch
    {
        "InReview" => "status-review",
        "Approved" => "status-approved",
        "Rejected" => "status-rejected",
        "Completed" => "status-completed",
        _ => "status-default"
    };
}
