<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Enterprise AI Orchestrator</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EnterpriseAIOrchestrator.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header">
        <div class="container header-shell">
            <a class="brand-block" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">EA</span>
                <span>
                    <strong>Enterprise AI Orchestrator</strong>
                    <small>Intake, routing, review, audit</small>
                </span>
            </a>
            <nav class="primary-nav" aria-label="Primary navigation">
                <a asp-controller="Home" asp-action="Index">Dashboard</a>
                <a asp-controller="Requests" asp-action="Create">Create Request</a>
                <a asp-controller="Requests" asp-action="Lookup">Lookup Run</a>
                <a asp-controller="Requests" asp-action="Recent">Recent Runs</a>
            </nav>
        </div>
    </header>

    <main class="container app-main" role="main">
        @RenderBody()
    </main>

    <footer class="app-footer">
        <div class="container">
            <span>EnterpriseAIOrchestrator</span>
            <span>ASP.NET Core MVC over the existing .NET 10 Web API</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
