@model CreateWorkRequestViewModel
@{
    ViewData["Title"] = "Submit Request";
}

<div class="page-heading">
    <p class="eyebrow">Internal intake</p>
    <h1>Submit Request</h1>
    <p>Capture the business context needed to classify, route, and review operational work.</p>
</div>

<div class="intake-layout">
    <form asp-action="Create" method="post" class="form-surface intake-form">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <section class="form-section">
            <div class="section-heading">
                <span class="panel-label">A</span>
                <h2>Request Information</h2>
                <p>Describe the work in enough detail for the orchestration pipeline to determine intent.</p>
            </div>
            <div class="form-grid">
                <div class="field field-wide">
                    <label asp-for="Title"></label>
                    <input asp-for="Title" class="form-control" placeholder="VPN access for remote employee" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>
                <div class="field field-wide">
                    <label asp-for="Description"></label>
                    <textarea asp-for="Description" class="form-control" rows="6" placeholder="Explain the request, business reason, timing, and any relevant policy context."></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
            </div>
        </section>

        <section class="form-section">
            <div class="section-heading">
                <span class="panel-label">B</span>
                <h2>Request Context</h2>
                <p>Provide ownership, priority, and tags that help operations teams scan and triage the run.</p>
            </div>
            <div class="form-grid">
                <div class="field">
                    <label asp-for="Department"></label>
                    <input asp-for="Department" class="form-control" placeholder="Operations" />
                    <span asp-validation-for="Department" class="text-danger"></span>
                </div>
                <div class="field">
                    <label asp-for="RequestedBy"></label>
                    <input asp-for="RequestedBy" class="form-control" placeholder="jane.doe@company.com" />
                    <span asp-validation-for="RequestedBy" class="text-danger"></span>
                </div>
                <div class="field">
                    <label asp-for="Priority"></label>
                    <select asp-for="Priority" class="form-select">
                        <option value="low">Low</option>
                        <option value="medium">Medium</option>
                        <option value="high">High</option>
                        <option value="critical">Critical</option>
                    </select>
                    <span asp-validation-for="Priority" class="text-danger"></span>
                </div>
                <div class="field">
                    <label asp-for="Tags"></label>
                    <input asp-for="Tags" class="form-control" placeholder="access, finance, urgent" />
                    <span asp-validation-for="Tags" class="text-danger"></span>
                </div>
            </div>
        </section>

        <div class="form-actions">
            <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">Cancel</a>
            <button type="submit" class="btn btn-primary">Submit Request</button>
        </div>
    </form>

    <aside class="panel guidance-panel">
        <div class="section-heading">
            <span class="panel-label">Pipeline</span>
            <h2>How this request will be processed</h2>
        </div>
        <ol class="process-list">
            <li>
                <strong>Classify</strong>
                <span>Identify the operational intent from the title, description, priority, and tags.</span>
            </li>
            <li>
                <strong>Assign business use case</strong>
                <span>Map the run to the most relevant enterprise workflow category.</span>
            </li>
            <li>
                <strong>Evaluate review requirement</strong>
                <span>Determine whether a human approval action is required before completion.</span>
            </li>
            <li>
                <strong>Generate audit trail</strong>
                <span>Record processing steps and review decisions for inspection later.</span>
            </li>
        </ol>
        <div class="example-box">
            <span class="panel-label">Good examples</span>
            <p>VPN or access provisioning, finance invoice handling, vacation or leave requests.</p>
        </div>
    </aside>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
