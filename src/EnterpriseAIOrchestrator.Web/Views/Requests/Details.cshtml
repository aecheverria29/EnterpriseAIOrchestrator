@model WorkflowRunDetailsViewModel
@{
    ViewData["Title"] = "Run Details";
}

<div class="page-heading split-heading run-title-block">
    <div>
        <p class="eyebrow">Workflow run details</p>
        <h1>@Model.Summary.OriginalTitle</h1>
        <p class="run-id-line">RunId <code>@Model.Summary.RunId</code></p>
    </div>
    <div class="run-title-actions">
        <span class="status-badge @BadgeClass(Model.Summary.WorkflowStatus)">@Model.Summary.WorkflowStatus</span>
        <a class="btn btn-outline-secondary" asp-action="Recent">Recent Runs</a>
    </div>
</div>

<section class="details-grid">
    <div class="metric-card">
        <span>Classification</span>
        <strong>@Model.Classification</strong>
    </div>
    <div class="metric-card">
        <span>Assigned Route</span>
        <strong>@Model.AssignedRoute</strong>
    </div>
    <div class="metric-card">
        <span>Business Use Case</span>
        <strong>@Model.Summary.BusinessUseCase</strong>
    </div>
    <div class="metric-card">
        <span>Default Owner</span>
        <strong>@Model.Summary.DefaultOwner</strong>
    </div>
</section>

<section class="run-layout">
    <div class="run-main">
        <section class="panel">
            <div class="section-heading">
                <span class="panel-label">A</span>
                <h2>Run Summary</h2>
            </div>
            <div class="summary-kv-grid">
                <div>
                    <span>Workflow Status</span>
                    <strong><span class="status-badge @BadgeClass(Model.Summary.WorkflowStatus)">@Model.Summary.WorkflowStatus</span></strong>
                </div>
                <div>
                    <span>Requires Approval Action</span>
                    <strong>@(Model.Summary.RequiresApprovalAction ? "Yes" : "No")</strong>
                </div>
                <div>
                    <span>Review Decision</span>
                    <strong>@(Model.ReviewDecision ?? "Pending")</strong>
                </div>
                <div>
                    <span>Target SLA Hours</span>
                    <strong>@Model.TargetSlaHours</strong>
                </div>
                <div>
                    <span>Started At</span>
                    <strong>@Model.Summary.StartedAt.ToString("g")</strong>
                </div>
                <div>
                    <span>Completed At</span>
                    <strong>@Model.Summary.CompletedAt.ToString("g")</strong>
                </div>
            </div>
            <div class="summary-text">
                <span class="panel-label">Final summary</span>
                <p>@Model.FinalSummary</p>
            </div>
        </section>

        <section class="panel">
            <div class="section-heading">
                <span class="panel-label">B</span>
                <h2>Processing Outcome</h2>
            </div>
            <div class="content-grid compact">
                <div>
                    <h3>Steps Executed</h3>
                    <ul class="step-list">
                        @foreach (var step in Model.StepsExecuted)
                        {
                            <li>@step</li>
                        }
                    </ul>
                </div>
                <div>
                    <h3>Validation Messages</h3>
                    @if (Model.ValidationMessages.Count == 0)
                    {
                        <p class="muted">No validation messages.</p>
                    }
                    else
                    {
                        <ul class="clean-list">
                            @foreach (var message in Model.ValidationMessages)
                            {
                                <li>@message</li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </section>

        <section class="panel">
            <div class="section-heading">
                <span class="panel-label">D</span>
                <h2>Audit Trail</h2>
            </div>
            <div class="timeline">
                @foreach (var entry in Model.AuditTrail.OrderBy(entry => entry.Timestamp))
                {
                    <div class="timeline-item">
                        <span>@entry.Timestamp.ToString("g")</span>
                        <strong>@entry.EventType</strong>
                        <p>@entry.Message</p>
                        @if (!string.IsNullOrWhiteSpace(entry.PerformedBy))
                        {
                            <small>Performed by @entry.PerformedBy</small>
                        }
                    </div>
                }
            </div>
        </section>
    </div>

    <aside class="run-side">
        @if (Model.Summary.RequiresApprovalAction)
        {
            <section class="panel review-panel">
                <div class="section-heading">
                    <span class="panel-label">C</span>
                    <h2>Review Actions</h2>
                    <p>This run is waiting for a human decision before it can leave review.</p>
                </div>
                <form asp-action="Approve" asp-route-runId="@Model.Summary.RunId" method="post" class="review-form">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="field">
                        <label asp-for="ReviewDecisionInput.PerformedBy"></label>
                        <input asp-for="ReviewDecisionInput.PerformedBy" name="PerformedBy" class="form-control" placeholder="manager@company.com" />
                    </div>
                    <div class="field">
                        <label asp-for="ReviewDecisionInput.Comment"></label>
                        <textarea asp-for="ReviewDecisionInput.Comment" name="Comment" class="form-control" rows="3" placeholder="Approval context or decision notes"></textarea>
                    </div>
                    <button type="submit" class="btn btn-success w-100">Approve Run</button>
                </form>
                <form asp-action="Reject" asp-route-runId="@Model.Summary.RunId" method="post" class="review-form">
                    <div class="field">
                        <label asp-for="ReviewDecisionInput.PerformedBy"></label>
                        <input asp-for="ReviewDecisionInput.PerformedBy" name="PerformedBy" class="form-control" placeholder="manager@company.com" />
                    </div>
                    <div class="field">
                        <label asp-for="ReviewDecisionInput.Comment"></label>
                        <textarea asp-for="ReviewDecisionInput.Comment" name="Comment" class="form-control" rows="3" placeholder="Reason for rejection"></textarea>
                    </div>
                    <button type="submit" class="btn btn-danger w-100">Reject Run</button>
                </form>
            </section>
        }
        else
        {
            <section class="panel">
                <div class="section-heading">
                    <span class="panel-label">C</span>
                    <h2>Review Actions</h2>
                    <p>No manual approval action is currently required for this run.</p>
                </div>
                <span class="review-indicator review-clear">No action required</span>
            </section>
        }

        <section class="panel">
            <div class="section-heading">
                <span class="panel-label">Ownership</span>
                <h2>Operational Routing</h2>
            </div>
            <div class="side-facts">
                <div>
                    <span>Route</span>
                    <strong>@Model.AssignedRoute</strong>
                </div>
                <div>
                    <span>Owner</span>
                    <strong>@Model.Summary.DefaultOwner</strong>
                </div>
                <div>
                    <span>Use Case</span>
                    <strong>@Model.Summary.BusinessUseCase</strong>
                </div>
            </div>
        </section>
    </aside>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@functions {
    private static string BadgeClass(string status) => status switch
    {
        "InReview" => "status-review",
        "Approved" => "status-approved",
        "Rejected" => "status-rejected",
        "Completed" => "status-completed",
        _ => "status-default"
    };
}
