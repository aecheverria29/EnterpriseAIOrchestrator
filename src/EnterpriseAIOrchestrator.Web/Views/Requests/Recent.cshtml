@model RecentRequestsViewModel
@{
    ViewData["Title"] = "Recent Runs";
}

<div class="page-heading">
    <p class="eyebrow">Workflow activity</p>
    <h1>Recent Runs</h1>
    <p>The latest runs currently held by the in-memory backend store.</p>
</div>

<div class="table-surface">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>RunId</th>
                <th>OriginalTitle</th>
                <th>BusinessUseCase</th>
                <th>WorkflowStatus</th>
                <th>RequiresApprovalAction</th>
                <th>DefaultOwner</th>
                <th>StartedAt</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @if (Model.Runs.Count == 0)
        {
            <tr>
                <td colspan="8" class="empty-state">No workflow runs have been created yet.</td>
            </tr>
        }
        else
        {
            foreach (var run in Model.Runs)
            {
                <tr>
                    <td><code>@run.RunId</code></td>
                    <td>@run.OriginalTitle</td>
                    <td>@run.BusinessUseCase</td>
                    <td><span class="status-badge @BadgeClass(run.WorkflowStatus)">@run.WorkflowStatus</span></td>
                    <td>@(run.RequiresApprovalAction ? "Yes" : "No")</td>
                    <td>@run.DefaultOwner</td>
                    <td>@run.StartedAt.ToString("g")</td>
                    <td>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-runId="@run.RunId">View</a>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>

@functions {
    private static string BadgeClass(string status) => status switch
    {
        "InReview" => "status-review",
        "Approved" => "status-approved",
        "Rejected" => "status-rejected",
        "Completed" => "status-completed",
        _ => "status-default"
    };
}
