@model LookupRequestViewModel
@{
    ViewData["Title"] = "Lookup Request";
}

<div class="page-heading">
    <p class="eyebrow">Run lookup</p>
    <h1>Lookup Request</h1>
    <p>Paste a workflow Run ID to open its orchestration details.</p>
</div>

<form asp-action="Lookup" method="post" class="form-surface narrow">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="field">
        <label asp-for="RunId"></label>
        <input asp-for="RunId" class="form-control" placeholder="00000000-0000-0000-0000-000000000000" />
        <span asp-validation-for="RunId" class="text-danger"></span>
    </div>
    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Open Details</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
